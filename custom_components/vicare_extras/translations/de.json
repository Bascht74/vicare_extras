  "config": {
    "abort": {
      "single_instance_allowed": "ViCare Extras ist bereits eingerichtet. Es ist nur eine Instanz möglich."
    },
    "step": {
      "user": {
        "description": "ViCare Extras ergänzt die eingebaute Integration Viessmann ViCare um Sensoren, Klima-Entitäten und Aktionen. Es nutzt die vorhandene Anmeldung, braucht keine eigenen Zugangsdaten und fragt die Viessmann-API nicht regelmäßig ab.\n\nEs liest nur, mit zwei Ausnahmen: Ein Befehl wird gesendet, wenn du an einer Klima-Entität von ViCare Extras die Solltemperatur änderst oder die Aktion send_command aufrufst.\n\nDie Integration Viessmann ViCare muss eingerichtet und geladen sein.",
        "title": "ViCare Extras"
      }
    }
  },
