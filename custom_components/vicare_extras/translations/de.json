  "options": {
    "step": {
      "init": {
        "title": "Optionen von ViCare Extras",
        "description": "Die Sensoren von ViCare Extras lösen nie API-Aufrufe aus. Aufrufe lassen sich nur sparen, indem die eingebaute Integration Viessmann ViCare seltener abfragt.",
        "data": {
          "vicare_poll_interval": "Abfrageintervall der ViCare-Integration"
        },
        "data_description": {
          "vicare_poll_interval": "Sekunden zwischen zwei Abfragen der eingebauten Integration (60 bis 900). Leer lassen, um deren eigenes Intervall (60 s je Gateway) beizubehalten. Wirkt ohne Neustart; die eingebaute Integration nutzt den neuen Wert nach ihrer nächsten Abfrage."
        }
      }
    }
  },
  "services": {
    "get_event_history": {
      "description": "Ruft die Ereignishistorie einer Anlage aus der Viessmann-Cloud ab. Jede abgerufene Seite ist ein API-Aufruf, der auf das Tageskontingent angerechnet wird. Meldungen werden mit Klartext ergänzt (decoded, summary).",
      "fields": {
        "cursor": {
          "description": "Setzt einen früheren Aufruf mit dessen next_cursor fort.",
          "name": "Cursor"
        },
        "edited_by": {
          "description": "Nur Ereignisse, die von diesem Benutzer oder System stammen (wird als editedBy an die API übergeben).",
          "name": "Bearbeitet von"
        },
        "event_type": {
          "description": "Nur diese Ereignistypen zurückgeben. Ein einzelner Typ wird von der API gefiltert, mehrere Typen werden nach dem Abruf gefiltert.",
          "name": "Ereignistyp"
        },
        "gateway_serials": {
          "description": "Seriennummern der Gateways für Ereignisse auf Gateway-Ebene (wird als gatewaySerials an die API übergeben).",
          "name": "Gateway-Seriennummern"
        },
        "installation_id": {
          "description": "Abzufragende Anlage. Standard ist die erste Anlage der ViCare-Integration.",
          "name": "Anlagen-ID"
        },
        "last_n_days": {
          "description": "Wie viele Tage zurückgeschaut wird.",
          "name": "Letzte n Tage"
        },
        "limit": {
          "description": "Ereignisse pro Seite (API-Maximum 1000).",
          "name": "Ereignisse pro Seite"
        },
        "max_pages": {
          "description": "Höchstzahl abzurufender Seiten. Jede Seite ist ein API-Aufruf.",
          "name": "Maximale Seitenzahl"
        }
      },
      "name": "Ereignishistorie abrufen"
    },
    "get_features": {
      "description": "Gibt die rohen Feature-Objekte eines ViCare-Geräts aus den Daten zurück, die die eingebaute Integration bereits abgerufen hat. Löst nie einen API-Aufruf aus.",
      "fields": {
        "device_id": {
          "description": "Gerät der Integration Viessmann ViCare. Standard ist das Heizgerät.",
          "name": "Gerät"
        },
        "device_type": {
          "description": "Viessmann-Gerätetyp, zum Beispiel heating, tcu oder roomControl.",
          "name": "Gerätetyp"
        },
        "full": {
          "description": "Vollständige Feature-Objekte samt Befehlen und URIs zurückgeben statt nur Name, Zeitstempel und Eigenschaften.",
