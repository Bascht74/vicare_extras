      "user": {
        "description": "ViCare Extras adds read-only actions and sensors on top of the built-in Viessmann ViCare integration. It reuses the existing login, needs no credentials of its own and does not poll the Viessmann API.\n\nThe Viessmann ViCare integration must be set up and loaded.",
        "title": "ViCare Extras"
      }
    }
  },
